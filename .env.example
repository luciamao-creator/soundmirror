# ===== 飞书应用凭证(占位符,真实值从飞书开放平台复制) =====
# 从 https://open.larksuite.com/ 创建应用后获得
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Verification Token(创建机器人时填的那个) =====
LARK_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Encrypt Key(如果开启了事件加密) =====
# 留空表示不加密
LARK_ENCRYPT_KEY=

# ===== Mavis 调用凭证 =====
# 待 M0C spike 验证后填入
MAVIS_API_KEY=

# ===== Mock 模式开关 =====
# true = 用 Mock Music Adapter(M1 阶段)
# false = 调真实 Matrix(M2 阶段)
MUSIC_MOCK_MODE=true

# ===== ngrok 公网入口 =====
# 从 https://dashboard.ngrok.com/signup 注册后获得
NGROK_AUTHTOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 可选:固定 subdomain(免费版可能需要信用卡验证)
NGROK_DOMAIN=soundmirror-m0c.ngrok.io

