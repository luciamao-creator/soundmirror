{
  "schema_version": "1.0",
  "description": "SoundMirror Action 唯一注册表。SKILL.md、director.md、interpreter.md、proposal.md 必须引用此 catalog,不得自维护白名单。",
  "risk_levels": {
    "normal": "无副作用或可逆副作用,直接执行",
    "costly": "消耗生成单元或预算,需确认",
    "persistent": "写入长期人格或改作用域,需确认作用域",
    "destructive": "永久删除,需二次确认 + 用户输入 '确认删除' 字样"
  },
  "actions": [
    {
      "action_id": "session.start",
      "label": "开始 / 开新歌",
      "allowed_stages": ["NEW"],
      "payload_schema": {"mode": "string (new|continue)"},
      "risk": "normal",
      "mutates_state": true,
      "consumes_generation_unit": false,
      "confirmation_policy": "none"
    },
    {
      "action_id": "session.pause",
      "label": "暂停",
      "allowed_stages": ["*"],
      "payload_schema": {},
      "risk": "normal",
      "mutates_state": true,
      "consumes_generation_unit": false,
      "confirmation_policy": "none"
    },
    {
      "action_id": "session.resume",
      "label": "继续",
      "allowed_stages": ["NEW"],
