  "risk_policies": {
    "normal": {
      "description": "直接执行",
      "ui_behavior": "按钮响应即可"
    },
    "costly": {
      "description": "消耗资源",
      "ui_behavior": "确认卡片显示'将消耗 X 个生成单元',用户点确认才执行"
    },
    "persistent": {
      "description": "改变长期状态",
      "ui_behavior": "确认卡片显示影响范围,用户点确认才执行"
    },
    "destructive": {
      "description": "永久不可逆",
      "ui_behavior": "确认卡片显示具体影响 + 必须输入确认字样才能执行"
    }
  },
  "two_stage_confirmation": {
    "description": "高危动作(costly / persistent / destructive)的两阶段确认协议",
    "protocol": [
      "1. LLM 返回 ActionCandidate with confirmation_policy != 'none'",
      "2. Stage Router 创建 PendingAction 记录(frozen payload + actor + session + revision + expires_at + status=pending)",
      "3. Gateway 发确认卡,提供两个唯一 action: confirm.accept, confirm.cancel(不是 high-risk action 本身)",
      "4. 用户点 confirm.accept → Orchestrator 验证 actor / session / revision / expiry → 执行 PendingAction 中被冻结的原动作",
      "5. confirm.cancel 或 expire → PendingAction.status=cancelled | expired,原动作不执行"
    ],
    "anti_loop": "确认卡的 action 必须是 confirm.accept / confirm.cancel,而非高危 action 本身。否则无限循环。",
    "schema": {
      "pending_action": {
        "pending_action_id": "pa_xxx",
        "original_action_id": "string (e.g., revision.request)",
        "frozen_payload": "object",
        "actor_user_id": "u_xxx",
        "creative_session_id": "cs_xxx",
        "state_revision": 12,
        "expires_at": "ISO-8601",
        "status": "pending | confirmed | cancelled | expired | executed"
      },
      "confirm_accept_payload": {"pending_action_id": "pa_xxx"},
      "confirm_cancel_payload": {"pending_action_id": "pa_xxx"}
    }
  }
}
