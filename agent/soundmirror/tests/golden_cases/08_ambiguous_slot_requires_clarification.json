    "默认 'B' 是 'identity.play' 然后保留另一个",
    "返回 candidates: [{action_id: 'identity.keep', payload: {slot: 'B'}, confidence: 0.5}]"
  ],
  "right_behaviors": [
    "返回 0 个 candidate",
    "fallback_response 把 'B' 可能指向的三个 action 都列出",
