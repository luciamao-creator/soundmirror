      {"action_id": "identity.play", "label": "▶ B 自然"},
      {"action_id": "identity.play", "label": "▶ C 辽阔"},
      {"action_id": "identity.keep", "label": "保留 A"},
      {"action_id": "identity.keep", "label": "保留 B"},
      {"action_id": "identity.keep", "label": "保留 C"},
      {"action_id": "identity.reject", "label": "排除 A"},
      {"action_id": "identity.reject", "label": "排除 B"},
      {"action_id": "identity.reject", "label": "排除 C"}
    ]
